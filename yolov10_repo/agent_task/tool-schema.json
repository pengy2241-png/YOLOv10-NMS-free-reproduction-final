{
  "schema_version": "1.0",
  "agent_policy": "deterministic_fixture_agent_v1",
  "tools": [
    {
      "name": "search_sources",
      "description": "Search the offline source manifest by keyword relevance and return ranked source metadata.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 10, "default": 5}
        },
        "required": ["query"],
        "additionalProperties": false
      }
    },
    {
      "name": "read_source",
      "description": "Read one source file from the offline pack and return its content plus SHA-256 provenance.",
      "input_schema": {
        "type": "object",
        "properties": {
          "source_id": {"type": "string", "pattern": "^S[0-9]+$"}
        },
        "required": ["source_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "write_final_brief",
      "description": "Write the one-page brief and a source-usage provenance file.",
      "input_schema": {
        "type": "object",
        "properties": {
          "content": {"type": "string", "minLength": 300, "maxLength": 5000},
          "citations": {
            "type": "array",
            "items": {"type": "string", "pattern": "^S[0-9]+$"},
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true
          }
        },
        "required": ["content", "citations"],
        "additionalProperties": false
      }
    },
    {
      "name": "validate_final_state",
      "description": "Run the independent final-state validator against the current run directory.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ]
}
